<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ledgerlens</groupId>
        <artifactId>ledger-lens-services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>analytics-service</artifactId>
    <name>analytics-service</name>
    <description>Stateless computation of return, volatility, max drawdown and Sharpe ratio</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Note what is absent: no spring-boot-starter-data-jpa, no database
             driver. This service owns no state. It reads what it needs from
             transaction-service over HTTP (day 5) and computes. That is the
             whole reason it can be scaled, restarted or lost without
             consequence. -->

        <!-- WireMock stands in for transaction-service in tests, so the
             analytics tests never need the other service running. Day 7. -->
        <dependency>
            <groupId>org.wiremock.integrations</groupId>
            <artifactId>wiremock-spring-boot</artifactId>
            <version>3.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
